# Bootstrap only — everything else is configured from the UI.

# AES-256-GCM key for secrets at rest:  openssl rand -base64 32
ENCRYPTION_KEY=
# Auth.js session secret:  npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (sign-in + "Connect Google Sheets")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Always an admin, can't be removed
OWNER_EMAIL=

# Upstash Redis (Vercel Marketplace sets these; KV_REST_API_URL / KV_REST_API_TOKEN also work).
# Leave empty locally to use a JSON file in .data/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local mock mode: fake sheets run by the real Code.gs, no Google needed.
# AUTH_DISABLED=1 is refused unless MOCK_SHEETS=1.
# MOCK_SHEETS=1
# AUTH_DISABLED=1
